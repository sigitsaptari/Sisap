{
  "badge": {
    "color": { "$type": "color", "$value": "{color.danger.600}" },
    "text-color": { "$type": "color", "$value": "{color.neutral.0}" },
    "border-color": { "$type": "color", "$value": "{color.neutral.0}" },
    "radius": { "$type": "dimension", "$value": "{border-radius.full}" },
    "neutral": {
      "bg": { "$type": "color", "$value": "{color.action.secondary}" },
      "fg": { "$type": "color", "$value": "{color.fg.default}" }
    },
    "brand": {
      "bg": { "$type": "color", "$value": "{color.action.primary}" },
      "fg": { "$type": "color", "$value": "{color.fg.on-brand}" }
    },
    "success": {
      "bg": { "$type": "color", "$value": "{color.feedback.success-bg}" },
      "fg": { "$type": "color", "$value": "{color.feedback.success}" }
    },
    "warning": {
      "bg": { "$type": "color", "$value": "{color.feedback.warning-bg}" },
      "fg": { "$type": "color", "$value": "{color.feedback.warning}" }
    },
    "destructive": {
      "bg": { "$type": "color", "$value": "{color.feedback.danger-bg}" },
      "fg": { "$type": "color", "$value": "{color.feedback.danger}" }
    },
    "danger": {
      "bg": { "$type": "color", "$value": "{color.feedback.danger-bg}" },
      "fg": { "$type": "color", "$value": "{color.feedback.danger}" }
    },
    "counter": {
      "bg": { "$type": "color", "$value": "{color.danger.600}" },
      "fg": { "$type": "color", "$value": "{color.neutral.0}" },
      "border": { "$type": "color", "$value": "{color.neutral.0}" }
    }
  }
}
