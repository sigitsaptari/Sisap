{
  "button": {
    "radius": { "$type": "dimension", "$value": "{border-radius.sm}" },
    "primary": {
      "bg": { "$type": "color", "$value": "{color.action.primary}" },
      "bg-hover": { "$type": "color", "$value": "{color.action.primary-hover}" },
      "bg-active": { "$type": "color", "$value": "{color.action.primary-active}" },
      "fg": { "$type": "color", "$value": "{color.fg.on-brand}" }
    },
    "secondary": {
      "bg": { "$type": "color", "$value": "{color.neutral.0}" },
      "bg-hover": { "$type": "color", "$value": "{color.neutral.50}" },
      "border": { "$type": "color", "$value": "{color.neutral.500}" },
      "fg": { "$type": "color", "$value": "{color.neutral.500}" }
    },
    "outline": {
      "border": { "$type": "color", "$value": "{color.neutral.500}" },
      "bg-hover": { "$type": "color", "$value": "{color.neutral.50}" },
      "fg": { "$type": "color", "$value": "{color.neutral.500}" }
    },
    "ghost": {
      "bg-hover": { "$type": "color", "$value": "{color.action.ghost-hover}" },
      "fg": { "$type": "color", "$value": "{color.fg.default}" }
    },
    "destructive": {
      "bg": { "$type": "color", "$value": "{color.action.danger}" },
      "bg-hover": { "$type": "color", "$value": "{color.action.danger-hover}" },
      "fg": { "$type": "color", "$value": "{color.fg.on-danger}" }
    },
    "danger": {
      "bg": { "$type": "color", "$value": "{color.action.danger}" },
      "bg-hover": { "$type": "color", "$value": "{color.action.danger-hover}" },
      "fg": { "$type": "color", "$value": "{color.fg.on-danger}" }
    }
  }
}
