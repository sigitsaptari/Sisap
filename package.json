{
  "name": "@sisapds/react",
  "version": "0.1.0",
  "description": "SisapDS — design system components (React + TypeScript + Tailwind CSS v4, W3C DTCG tokens)",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "tokens:build": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens:build && tsc -p tsconfig.build.json",
    "dev": "npm run dev --workspace @sisapds/playground",
    "storybook": "npm run storybook --workspace @sisapds/storybook",
    "build-storybook": "npm run build-storybook --workspace @sisapds/storybook"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.0",
    "lucide-react": "^1.52.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0"
  }
}
